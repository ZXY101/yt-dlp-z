{
  "name": "yt-dlp-z-root",
  "private": true,
  "description": "Repo-level dev tooling (git hooks, commit linting). App code lives in backend/ and frontend/.",
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "npm run format:check && npm run lint && npm run knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "knip": "^6.44.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10"
  },
  "allowScripts": {
    "lefthook@2.2.2": true
  },
  "workspaces": [
    "frontend",
    "e2e"
  ]
}
